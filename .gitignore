# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# --- Virtual environments ---------------------------------------------------
.venv/
venv/
env/

# --- Node / frontend ---------------------------------------------------------
node_modules/
frontend/dist/
*.local
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# --- Environment / secrets ---------------------------------------------------
.env
.env.*
!.env.example
*.cred.key
credentials.enc

# --- App runtime data ---------------------------------------------------------
/data/
/logs/
/downloads/
/backups/
*.db-journal
*.db-wal
*.db-shm

# --- PR24D-L2: local Staging/UAT installer runtime state -----------------------
# Generated by install.ps1/update.ps1 -- never a source of truth for
# database state, never contains a secret, but not repository content
# either. deployment/local-staging/.env itself is already covered by the
# generic `.env`/`.env.*` patterns above.
deployment/local-staging/logs/
deployment/local-staging/.install.lock
deployment/local-staging/.install-metadata.json

# --- Testing ------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/

# --- Build output ---------------------------------------------------------
/build/
/dist/

# --- Editor / OS ------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
