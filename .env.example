# ---------------------------------------------------------------------------
# Medical Device Recall Monitor - Environment configuration
# Copy this file to ".env" and adjust the values for your hospital site.
# NEVER commit the real ".env" file (it is already in .gitignore).
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
APP_ENV=production
APP_NAME=Medical Device Recall Monitor
LOG_LEVEL=INFO
LOG_DIR=./logs
DATA_DIR=./data
DOWNLOAD_DIR=./downloads
BACKUP_DIR=./backups

# --- Database ----------------------------------------------------------------
DATABASE_PATH=./data/recall_monitor.db

# --- FDA Scraper -------------------------------------------------------------
FDA_SEARCH_URL=https://www.accessdata.fda.gov/scripts/cdrh/cfdocs/cfres/res.cfm
# Optional resilient fallback: openFDA public REST API (no key required).
# Used automatically if the HTML form on FDA_SEARCH_URL cannot be parsed
# (site layout change) - see app/scraper/fda.py for details.
FDA_OPENFDA_API_URL=https://api.fda.gov/device/recall.json
FDA_USE_OPENFDA_FALLBACK=true
FDA_REQUEST_TIMEOUT_MS=30000

# --- ECRI Alerts Tracker -------------------------------------------------------
ECRI_LOGIN_URL=https://sts.ecri.org/
ECRI_ALERTS_URL=https://sts.ecri.org/alerts
ECRI_REQUEST_TIMEOUT_MS=30000
# Credentials are NEVER stored here - the app prompts on first run and stores
# them in the OS credential vault via the `keyring` package.

# --- Playwright ----------------------------------------------------------------
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSER=chromium

# --- Matching Engine -----------------------------------------------------------
FUZZY_MATCH_THRESHOLD=90
POSSIBLE_MATCH_THRESHOLD=75

# --- Scheduler -----------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_FREQUENCY=weekly
# daily | weekly | monthly
SCHEDULER_HOUR=6
SCHEDULER_MINUTE=0

# --- Email / Outlook (bonus) -----------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=
EMAIL_REPORT_RECIPIENTS=

# --- UI --------------------------------------------------------------------------
UI_THEME=dark
