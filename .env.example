# Copy to .env and fill in real values before running docker compose.

# --- Database ---
POSTGRES_DB=mep_db
POSTGRES_USER=mep_user
POSTGRES_PASSWORD=change-me

# --- Cache ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-random-64-byte-value
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# Per-account login lockout. OFF by default (Owner decision 2026-11-01).
# MUST be set to true before any external/internet access (e.g. Cloudflare
# Tunnel, PR25C). When false, failures are still counted and audited.
LOGIN_LOCKOUT_ENABLED=false
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10

# --- CORS ---
ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# --- Object storage (MinIO / S3-compatible) ---
S3_ENDPOINT=http://minio:9000
S3_BUCKET=mep-attachments
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# --- Notifications (Phase 2) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=noreply@hospital.local

# --- Misc ---
ENVIRONMENT=development
PM_DUE_SOON_DAYS=7
CAL_DUE_SOON_DAYS=7
