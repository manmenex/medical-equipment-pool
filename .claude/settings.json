{
  "permissions": {
    "allow": [
      "Bash(python -m pytest:*)",
      "Bash(python -m alembic current)",
      "Bash(python -m alembic history:*)",
      "Bash(npm run test)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.cred.key)",
      "Read(./**/credentials.enc)",
      "Read(./deployment/local-staging/backups/**)",
      "Read(./backups/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(sudo:*)"
    ]
  }
}
