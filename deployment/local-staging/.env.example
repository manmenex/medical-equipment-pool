# Local Staging/UAT deployment configuration. `.\install.ps1`
# (PR24D-L2) generates this file's real values automatically on a fresh
# install and preserves them unchanged on every later run -- manual
# copy-and-fill (as below) remains available for anyone running
# `docker compose` directly without the installer.
#
# Copy to .env in this same directory and fill in real values before
# running `docker compose -f compose.yml up`. Never commit the filled-in
# .env file (already covered by the repository's root .gitignore `.env`/
# `.env.*` patterns) -- it will contain real secrets.
#
# This is NOT a fourth environment. It configures a local execution of
# the existing Staging/UAT environment class (OD-PR24-4). ENVIRONMENT is
# intentionally fixed to "production" in compose.yml itself (not
# configurable here) to keep validate_production_secrets()'s hardened
# checks in effect.

# --- Database ---
POSTGRES_DB=mep_local_staging_db
POSTGRES_USER=mep_local_staging_user
# Generate a real, unique value -- never "change-me", "mep_password", or
# any other value that also appears in this repository's own source code
# (backend/app/core/config.py's INSECURE_DATABASE_PASSWORDS would refuse
# to start with one of those under ENVIRONMENT=production).
POSTGRES_PASSWORD=

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# --- Network ---
# The exact LAN URL(s) this deployment will actually be reached at, e.g.
# http://192.168.1.50 -- comma-separated if more than one. Never a
# hardcoded hospital IP committed to source control; this file itself is
# gitignored once copied to .env. Same-origin browser requests (frontend
# and API both served from this same origin via the nginx reverse proxy)
# never actually trigger a CORS check, so this value's only enforced
# purpose today is satisfying validate_production_secrets()'s "not the
# shipped localhost-only default" check -- but it must still be set to
# this host's real reachable address for forward compatibility and
# operator clarity.
ALLOWED_ORIGINS=

# Host port for the frontend/reverse-proxy. Change only if 80 is already
# in use on the Windows host (e.g. by IIS or another local service).
LOCAL_STAGING_HTTP_PORT=80
